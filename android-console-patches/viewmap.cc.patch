+// Cursor jumps that should drag the physical viewport along: the landmark
+// keys listed in the map header (< > tab _ ^ E W I) and the jump-back-to-
+// player key. Plain cursor movement is excluded so it can pan freely.
+static bool _is_map_jump_command(command_type cmd)
+{
+    switch (cmd)
+    {
+    case CMD_MAP_FIND_YOU:
+    case CMD_MAP_FIND_UPSTAIR:
+    case CMD_MAP_FIND_DOWNSTAIR:
+    case CMD_MAP_FIND_PORTAL:
+    case CMD_MAP_FIND_TRAP:
+    case CMD_MAP_FIND_ALTAR:
+    case CMD_MAP_FIND_EXCLUDED:
+    case CMD_MAP_FIND_WAYPOINT:
+    case CMD_MAP_FIND_STASH:
+    case CMD_MAP_FIND_STASH_REVERSE:
+        return true;
+    default:
+        return false;
+    }
+}
 #endif
 
