-    return pad_more_with(navigation, "<lightgrey>[<w>XXX</w>]</lightgrey>");
+    navigation += "\n<lightgrey>"
+        + menu_keyhelp_cmd(CMD_MENU_EXIT) + " exit</lightgrey>";
+    return navigation;
 }
 
 // use the class's built in keyhelp string
@@ -1733,7 +1834,10 @@ bool Menu::process_command(command_type cmd)
     case CMD_MENU_UP:
         if (is_set(MF_ARROWS_SELECT))
