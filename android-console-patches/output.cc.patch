+    // Android Compact HUD: compute the per-mille (0..1000) fill boundaries for
+    // the native vertical bar, updating the change-tracking state exactly like
+    // draw() so the recent-damage sliver and the timed clear behave the same.
+    // out8 receives [def_pm, cur_pm, old_pm, m_default, m_change_pos, YELLOW,
+    // m_change_neg, m_empty]; the caller converts the five colour enums to ARGB.
+    // Only ever called in compact mode, where draw() is never called on the same
+    // object, so m_old_disp lives entirely in per-mille units here.
+    void compute_native_zones(int val, int max_val, int sub_val, int out8[8])
+    {
+        if (max_val <= 0)
+        {
+            m_old_disp = -1;
+            for (int i = 0; i < 8; i++)
+                out8[i] = 0;
+            return;
+        }
+        const int sub_disp = 1000 * val / max_val;
+        int disp = 1000 * max(0, val - sub_val) / max_val;
+        const int old_disp = (m_old_disp < 0) ? sub_disp : m_old_disp;
+        m_old_disp = sub_disp;
+        if (sub_val)
+            disp = max(0, min(sub_disp - 1, disp));
+
+        if (old_disp != disp)
+            m_request_redraw_after = you.num_turns + 4;
+        else
+            m_request_redraw_after = 0;
+
+        out8[0] = disp;
+        out8[1] = sub_disp;
+        out8[2] = old_disp;
+        out8[3] = m_default;
+        out8[4] = m_change_pos;
+        out8[5] = YELLOW;
+        out8[6] = m_change_neg;
+        out8[7] = m_empty;
+    }
