+// ----------------------------------------------------------------------
+// Android Compact HUD
+//
+// A user preference (boot-wired; toggling hard-relaunches the game). It frees
+// three terminal HUD rows so the map panel can grow: the title and vitals lines
+// move to native scrollable views, and the HP/MP bars to a native vertical-bar
+// view. Only two terminal HUD rows remain, plus weapon/quiver/status:
+//   row 1: Noise   | AC | EV | SH
+//   row 2: @:Place | Str | Int | Dex
+//   row 3: weapon      row 4: quiver      rows 5-6: status-light cells (cleared)
+// XL, piety, Doom, Contam and the turn count live on the native vitals row.
+// The stat printers are shared with the standard condensed HUD but shift the
+// AC/EV and Str/Int columns 1 col right in compact mode (gated on
+// android_compact_hud) to tighten the inter-stat gaps; SH/Dex stay pinned.
+// ----------------------------------------------------------------------
+
+// Compact Place field: always the full branch short name. Colon removal plus
+// the +1 stat shift opened cols on the left, so the place field spans cols
+// 3..19 (17 chars after "@:"), which easily fits every branch's shortname plus
+// its ":depth" suffix (longest: "Hall of Blades" = 14, "Orcish Mines:4" = 14),
+// so the old abbrev fallback is no longer needed. chop_string still clips at
+// 17 as a safety net for any unforeseen longer name.
+static string _level_description_string_hud_compact()
+{
+    const PlaceInfo& place = you.get_place_info();
+    string s = branches[place.branch].shortname;
+    if (brdepth[place.branch] > 1)
+        s += make_stringf(":%d", you.depth);
+    return s;
+}
+
+static void _print_compact_place(int y)
+{
+    CGOTOXY(1, y, GOTO_STAT);
+    textcolour(HUD_CAPTION_COLOUR);
+    NOWRAP_EOL_CPRINTF("@:");
+    textcolour(HUD_VALUE_COLOUR);
+    // Chop to 18 so "@:" + place never reaches col 21 (where the Str label now
+    // sits after the colon removal and the +2 stat shift); a runaway name is
+    // cut off rather than bleeding into the stats.
+    NOWRAP_EOL_CPRINTF("%s",
+        chop_string(_level_description_string_hud_compact(), 18, false).c_str());
+    // Pad the remainder of the left field to col 20 to erase a longer stale
+    // place name; NOWRAP clips so we can't touch the Str value slot.
+    int col = wherex() - crawl_view.hudp.x;
+    for (int i = 20 - col; i > 0; i--)
+        NOWRAP_EOL_CPRINTF(" ");
+    CGOTOXY(1, y, GOTO_STAT);
+}
+
+// Push the native title row: name + title + species + [of God]. No piety here
+// (piety rides the vitals row); one YELLOW segment, scrollable Java-side.
+static void _push_compact_title()
+{
+    string title = filtered_lang(player_title());
+    title = you.your_name + (title[0] == ',' ? "" : " ") + title;
+    title += " ";
+    title += player_species_name();
+    if (!you_worship(GOD_NO_GOD))
+    {
+        title += " of ";
+        title += you_worship(GOD_JIYVA) ? god_name_jiyva(true)
+                                        : god_name(you.religion);
+    }
+    const char* seg = title.c_str();
+    int col = YELLOW;
+    android_send_hud_title(&seg, &col, 1);
+    you.redraw_title = false;
+}
+
+// Push the native vitals row: HP / MP / XL / piety / Doom / Contam / turns.
+// Segments carry their own colours; spacing is baked into the caption text.
+static void _push_compact_vitals()
+{
+    vector<string> segs;
+    vector<int> cols;
+
+    // HP (number colour uses the same threshold logic as _print_stats_hp).
+    {
+        short hp_colour = HUD_VALUE_COLOUR;
+        if (_boosted_hp())
+            hp_colour = LIGHTBLUE;
+        else
+        {
+            const int hp_percent = (you.hp * 100) / get_real_hp(true, true);
+            for (const auto &e : Options.hp_colour)
+                if (hp_percent <= e.first)
+                    hp_colour = e.second;
+        }
+        segs.push_back("HP");
+        cols.push_back(HUD_CAPTION_COLOUR);
+        const int max_max_hp = get_real_hp(true, false);
+        string v = make_stringf(" %d/%d", you.hp, you.hp_max);
+        if (max_max_hp != you.hp_max)
+            v += make_stringf(" (%d)", max_max_hp);
+        segs.push_back(v);
+        cols.push_back(hp_colour);
+    }
+
+    // MP (omitted entirely for Djinn / MUT_HP_CASTING).
+    if (!you.has_mutation(MUT_HP_CASTING))
+    {
+        short mp_colour = HUD_VALUE_COLOUR;
+        if (_boosted_mp())
+            mp_colour = LIGHTBLUE;
+        else
+        {
+            const int mp_percent = you.max_magic_points == 0 ? 100
+                : (you.magic_points * 100) / you.max_magic_points;
+            for (const auto &e : Options.mp_colour)
+                if (mp_percent <= e.first)
+                    mp_colour = e.second;
+        }
+        segs.push_back("  MP");
+        cols.push_back(HUD_CAPTION_COLOUR);
+        segs.push_back(make_stringf(" %d/%d", you.magic_points,
+                                    you.max_magic_points));
+        cols.push_back(mp_colour);
+    }
+
+    // XL as a decimal reading: integer level + fractional progress (#.##),
+    // the fractional part dimmed. Saves the " (…%)" wrapper's two chars.
+    segs.push_back("  XL");
+    cols.push_back(HUD_CAPTION_COLOUR);
+    segs.push_back(make_stringf(" %d", you.experience_level));
+    cols.push_back(HUD_VALUE_COLOUR);
+    if (you.experience_level >= you.get_max_xl())
+    {
+        segs.push_back(" (max)");
+        cols.push_back(HUD_CAPTION_COLOUR);
+    }
+    else
+    {
+        segs.push_back(make_stringf(".%d",
+            min(9, (get_exp_progress() + 5) / 10)));
+        cols.push_back(DARKGRAY);
+    }
+
+    // Doom (hidden until accumulated, unless always_show_doom_contam).
+    if (you.attribute[ATTR_DOOM] > 0 || Options.always_show_doom_contam)
+    {
+        const int d = you.attribute[ATTR_DOOM];
+        int c = DARKGRAY;
+        if (d >= 75)
+            c = LIGHTMAGENTA;
+        else if (d >= 50)
+            c = LIGHTRED;
+        else if (d >= 25)
+            c = YELLOW;
+        else if (d > 0)
+            c = LIGHTGRAY;
+        segs.push_back("  Doom:");
+        cols.push_back(HUD_CAPTION_COLOUR);
+        segs.push_back(make_stringf("%d%%", d));
+        cols.push_back(c);
+    }
+
+    // Contamination (hidden until accumulated, unless always_show_doom_contam).
+    if (you.magic_contamination > 0 || Options.always_show_doom_contam)
+    {
+        const int contam = max(you.magic_contamination > 0 ? 1 : 0,
+                               you.magic_contamination / 10);
+        int c = DARKGRAY;
+        if (contam >= 200)
+            c = RED;
+        else if (contam >= 100)
+            c = YELLOW;
+        segs.push_back("  Contam:");
+        cols.push_back(HUD_CAPTION_COLOUR);
+        segs.push_back(make_stringf("%d%%", contam));
+        cols.push_back(c);
+    }
+
+    // Turn count (+ delta), matching the standard bottom row's format.
+    segs.push_back("  T:");
+    cols.push_back(HUD_CAPTION_COLOUR);
+    {
+        string time_str = Options.show_game_time
+            ? make_stringf("%.1f", you.elapsed_time / 10.0)
+            : make_stringf("%d", you.num_turns);
+        time_str += make_stringf(" (%.1f)",
+            (you.elapsed_time - you.elapsed_time_at_last_input) / 10.0);
+        segs.push_back(time_str);
+        cols.push_back(HUD_VALUE_COLOUR);
+    }
+
+    const int n = (int)segs.size();
+    const char** texts = new const char*[n];
+    int* c = new int[n];
+    for (int i = 0; i < n; i++)
+    {
+        texts[i] = segs[i].c_str();
+        c[i] = cols[i];
+    }
+    android_send_hud_vitals(texts, c, n);
+    delete[] texts;
+    delete[] c;
+}
+
+// Push the native vertical HP/MP bars. Zone maths mirror colour_bar::draw()
+// (poison sub-bar for HP, recent-change sliver, timed clear). Djinn: no MP bar.
+static void _push_compact_bars()
+{
+    int hp[8];
+    HP_Bar.compute_native_zones(you.hp, you.hp_max,
+        you.hp - max(0, poison_survival()), hp);
+    if (you.has_mutation(MUT_HP_CASTING))
+        android_send_hud_bars(hp, 8, nullptr, 0);
+    else
+    {
+        int mp[8];
+        MP_Bar.compute_native_zones(you.magic_points, you.max_magic_points,
+                                    0, mp);
+        android_send_hud_bars(hp, 8, mp, 8);
+    }
+}
+
+static void _print_stats_compact()
+{
+    cursor_control coff(false);
+    textcolour(LIGHTGREY);
+
+    // Displayed evasion is tied to dex/str.
+    if (you.redraw_stats[STAT_DEX] || you.redraw_stats[STAT_STR])
+        you.redraw_evasion = true;
+
+    if (HP_Bar.wants_redraw())
+        you.redraw_hit_points = true;
+    if (MP_Bar.wants_redraw())
+        you.redraw_magic_points = true;
+
+    // Poison display depends on regen rate, so redraw every turn while poisoned.
+    if (you.duration[DUR_POISONING])
+    {
+        you.redraw_hit_points = true;
+        you.redraw_status_lights = true;
+    }
+
+    // --- Native rows (JNI pushes gated on the same redraw_* flags) ---
+    if (you.redraw_title)
+        _push_compact_title();
+
+    // Bars refresh every call so they never blank out when HP/MP sit full and
+    // stable (no redraw flag fires then). compute_native_zones trails m_old_disp
+    // by one call, matching the standard console draw()'s change-sliver decay.
+    _push_compact_bars();
+
+    bool vitals_dirty = you.redraw_experience || you.redraw_doom
+                        || you.redraw_contam
+                        || you.redraw_hit_points || you.redraw_magic_points;
+    if (vitals_dirty)
+        _push_compact_vitals();
+    you.redraw_hit_points = false;
+    you.redraw_magic_points = false;
+    you.redraw_experience = false;
+    you.redraw_doom = false;
+    you.redraw_contam = false;
+
+    // --- Terminal rows 1-2 ---
+    // Noise shares row 1 with AC/EV/SH (its standard-HUD row); Place drops to
+    // row 2 beside Str/Int/Dex. Place refreshes cheaply every call (no dedicated
+    // redraw flag; Java diffs the frame before any JNI, so unchanged cells cost
+    // nothing downstream).
+    _print_compact_place(2);
+
+    if (Options.equip_bar)
+    {
+        if (you.gear_change || you.wield_change)
+            _print_stats_equip(1, 1);
+    }
+    else if (you.redraw_noise)
+        _print_stats_noise(1, 1);
+
+    if (you.redraw_armour_class)
+        _print_stats_ac(1, 1);
+    if (you.redraw_evasion)
+        _print_stats_ev(1, 1);
+
+    // Compact shifts Str 2 cols and Int 1 col right (Dex stays pinned at the
+    // edge); _print_stat draws the sign at x+4 and digits at x+5, giving sign
+    // cols 24/32/40 and digit cols 25/33/41, evenly spaced and aligned under
+    // AC/EV/SH.
+    static const int stat_label_cols[NUM_STATS] = { 20, 28, 36 };
+    for (int i = 0; i < NUM_STATS; ++i)
+        if (you.redraw_stats[i])
+            _print_stat(static_cast<stat_type>(i), stat_label_cols[i], 2);
+    you.redraw_stats.init(false);
+
+    if (you.wield_change)
+        _print_stats_wp(3);
+    if (you.redraw_quiver)
+        _print_stats_qv(4);
+
+    if (you.redraw_status_lights)
+    {
+        vector<status_light> lights;
+        _get_status_lights(lights);
+        const int n = (int)lights.size();
+        if (n > 0)
+        {
+            const char** texts = new const char*[n];
+            int* cols = new int[n];
+            for (int i = 0; i < n; i++)
+            {
+                texts[i] = lights[i].text.c_str();
+                cols[i] = (int)lights[i].colour;
+            }
+            android_send_status_lights(texts, cols, n);
+            delete[] texts;
+            delete[] cols;
+        }
+        else
+            android_send_status_lights(nullptr, nullptr, 0);
+
+        for (int row = 5; row <= 6 && row <= (int)crawl_view.hudsz.y; row++)
+        {
+            CGOTOXY(1, row, GOTO_STAT);
+            clear_to_end_of_line();
+        }
+        you.redraw_status_lights = false;
+    }
+
+#ifndef USE_TILE_LOCAL
+    assert_valid_cursor_pos();
+#endif
+}
