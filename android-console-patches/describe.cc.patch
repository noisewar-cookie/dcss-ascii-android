+    // room and hang-indent the bonus so continuations align under "Bonus".
+    extern int android_prose_wrap_cols;
+    extern bool android_reflow_attack_bonus;
+    const bool reflow = android_prose_wrap_cols > 0
+                        && android_reflow_attack_bonus && di.has_any_flavour;
+    const char *dmg_header = "Max Damage";
+    if (reflow)
+    {
+        dmg_header = "Max Dmg";
+        size_t dmg_w = strlen(dmg_header);
+        for (const string &d : di.damage_descriptions)
+            dmg_w = max(dmg_w, (size_t) strwidth(d));
+        di.damage_width = dmg_w;
+    }
+
     // Hopefully enough width for every possibility
     di.damage_width    = min(di.damage_width, (size_t) 31);
     di.bonus_width     = min(di.bonus_width, 69 - di.damage_width);
