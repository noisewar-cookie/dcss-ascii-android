     if (di.has_any_flavour)
     {
-        result << padded_str(di.flavour_without_dam ? "Bonus"
-                                                    : "After Damaging Hits",
-                             di.bonus_width);
+        const string bonus_header = di.flavour_without_dam
+                                    ? "Bonus" : "After Damaging Hits";
+        // Bonus is the last column; skip trailing pad under reflow so the
+        // header row doesn't overshoot the panel and fold.
+        result << (reflow ? bonus_header
+                          : padded_str(bonus_header, di.bonus_width));
     }
     result << "\n";
 
     // Table body
+    const int bonus_col = di.attk_desc_width + 2 + di.damage_width + 2;
     for (unsigned int i = 0; i < di.attack_descriptions.size(); ++i)
     {
         result << chop_string(di.attack_descriptions[i], di.attk_desc_width)
                << "  "
                << chop_string(di.damage_descriptions[i], di.damage_width)
-               << "  "
-               << chop_string(di.bonus_descriptions[i], di.bonus_width)
-               << "\n";
+               << "  ";
+        if (reflow)
+        {
+            string bonus = di.bonus_descriptions[i];
+            if (!bonus.empty())
+            {
+                const int avail = max(8, android_prose_wrap_cols - bonus_col);
+                linebreak_string(bonus, avail);
+                bonus = replace_all(bonus, "\n", "\n" + string(bonus_col, ' '));
+            }
+            result << bonus << "\n";
+        }
+        else
+        {
+            result << chop_string(di.bonus_descriptions[i], di.bonus_width)
+                   << "\n";
+        }
     }
 }
 
