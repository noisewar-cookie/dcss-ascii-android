<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="preferExternal" >

    <!-- No storage permissions needed: backup/restore uses Storage Access
         Framework (ACTION_OPEN_DOCUMENT_TREE), settings/morgue live in
         getExternalFilesDir(), and saves stay in app-private internal. -->

    <!-- Network: only for the in-game wiki button's WebView (the modal that
         loads dcss.roguelikes.gg). Normal install-time permission, no runtime
         prompt. The rest of the app is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Compile SDK specified in build.gradle -->

    <!-- Opt out of predictive back: targetSdk 36 enables it by default,
         which stops KEYCODE_BACK from reaching GameActivity.onKeyDown,
         so back finished the activity (clean app exit) instead of
         sending ESC to the game. -->
    <application
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:name=".CrawlApplication"
        android:theme="@style/Theme.Crawl"
        android:label="@string/app_name" >
        <activity
            android:name=".activity.ControlsInfoActivity"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.SplashActivity"
            android:configChanges="orientation|keyboardHidden"
            android:screenOrientation="portrait"
            android:exported="false">
        </activity>
        <activity
            android:name=".activity.GameActivity"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            >
        </activity>
        <activity
            android:name=".activity.HelpActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden"
            >
        </activity>
        <activity
            android:name=".activity.CharacterFilesActivity"
            android:label="@string/morgue"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden">
        </activity>
        <activity
            android:name=".ConfigEditor"
            android:theme="@style/Theme.Crawl.Editor"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden"
            android:label="Config Editor">
        </activity>
        <!-- Theme.Crawl.Editor follows the system day/night setting (see
             res/values-night/styles.xml) — dark mode gets light-on-dark. -->
        <activity
            android:name=".CharFileViewer"
            android:theme="@style/Theme.Crawl.Editor"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden"
            android:label="Character File Viewer">
        </activity>
        <activity android:name=".activity.PreferencesActivity"
            android:screenOrientation="portrait"
            android:exported="false">
            <intent-filter>
                <action android:name="org.angdroid.angband.PREF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".activity.FontPickerActivity"
            android:screenOrientation="portrait"
            android:exported="false">
        </activity>
        <activity android:name=".activity.CustomKeyboardActivity"
            android:theme="@style/Theme.Crawl.CustomKeyboard"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden"
            android:label="Customize keyboard">
        </activity>
    </application>

</manifest>
