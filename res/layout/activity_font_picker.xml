<?xml version="1.0" encoding="utf-8"?>
<!-- Dark full-screen font picker with shared preview and import button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:id="@+id/font_picker_root">

    <!-- Title + import bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#FF1A1A1A">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/font_picker_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_import_font"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/font_import"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@android:color/white" />
    </LinearLayout>

    <!-- Shared preview rendered in the selected font -->
    <TextView
        android:id="@+id/font_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#FFCCCCCC"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FF111111" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF333333" />

    <ListView
        android:id="@+id/font_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#FF222222"
        android:dividerHeight="1dp"
        android:cacheColorHint="#FF000000"
        android:listSelector="@android:color/transparent" />

    <!-- Bottom bar: Exit + Apply. Hidden when selection matches saved. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#FF1A1A1A"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/font_exit"
            android:textColor="#FFBBBBBB"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:background="#FF333333"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/font_apply"
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:background="@android:color/white" />
    </LinearLayout>

</LinearLayout>
