<?xml version="1.0" encoding="utf-8"?>
<!-- id must stay @android:id/checkbox so CheckBoxPreference can toggle it.
     PlainCheckBox keeps the theme's green check but suppresses the orange
     pressed/selected highlight. -->
<com.crawlmb.PlainCheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/checkbox"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:clickable="false"
    android:background="@null" />
