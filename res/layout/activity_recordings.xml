<?xml version="1.0" encoding="utf-8"?>
<!-- Replays library: title + import bar (as the font picker), column header, list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:id="@+id/recordings_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/crawl_surface">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recordings_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_import_replay"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:minHeight="0dp"
            android:text="@string/recordings_import"
            android:textSize="13sp"
            style="@style/Widget.Crawl.Button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FF111111">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recordings_col_name"
            android:textColor="#FF909090"
            android:textSize="12sp" />

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/recordings_col_size"
            android:textColor="#FF909090"
            android:textSize="12sp" />

        <TextView
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/recordings_col_saved"
            android:textColor="#FF909090"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF333333" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#FF222222"
        android:dividerHeight="1dp"
        android:cacheColorHint="#FF000000" />

    <TextView
        android:id="@android:id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:text="@string/recordings_empty"
        android:textColor="#FFCCCCCC"
        android:textSize="14sp" />

</LinearLayout>
