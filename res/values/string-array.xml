<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- This is the message that shows on the terminal when the game loads -->
    <!-- It's important that none of these lines are more than 80 characters long -->
    <!-- and there can't be more than 24 lines -->
    <string-array name="loading_message_array">
        <item> </item>
        <item>PLEASE WAIT...</item>
        <item>First time launching may take some time.</item>
        <item> </item>
        <item>Use 2-finger long-press on the screen to access the app menu.</item>
        <item> </item>
        <item>The screen is divided into a 3 X 3 grid for touch input.</item>
        <item>Tapping in grid areas sends directional keys, center to rest.</item>
        <item> </item>
        <item>Feel free to bring suggestions to the project repo!</item>
        <item> </item>
        <item>Happy crawling!</item>
    </string-array>

    <!-- Compact-mode HP/MP bar position picker. Order/values must stay in
         sync; values are matched by Preferences.getCompactBarSide(). -->
    <string-array name="compactBarSideDescriptions">
        <item>Left side</item>
        <item>Right side</item>
        <item>Off</item>
    </string-array>
    <string-array name="compactBarSideValues" translatable="false">
        <item>left</item>
        <item>right</item>
        <item>off</item>
    </string-array>
</resources>