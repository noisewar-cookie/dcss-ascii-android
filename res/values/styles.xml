<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--@android:style/Theme.NoTitleBar.Fullscreen"-->
    <!-- Editor theme: follows the system day/night setting via the -night
         resource qualifier (see res/values-night/styles.xml). On API <29
         devices (no system dark mode) this always resolves to the light
         variant, which is fine — those devices have no toggle to follow.
         windowOptOutEdgeToEdgeEnforcement disables Android 15's default
         edge-to-edge so the action bar/nav bar push content out of the way
         instead of overlaying it (otherwise the file's first lines hide
         behind the action bar and the last lines behind the nav bar). The
         attribute is API 35+; older devices ignore it and don't enforce
         edge-to-edge anyway. -->
    <style name="Theme.Crawl.Editor" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- CustomKeyboardActivity sits at the bottom of the screen with the
         virtual keyboard pinned to the parent bottom. Opt out of Android
         15's edge-to-edge enforcement so the gesture/nav bar pushes the
         keyboard up instead of overlaying its bottom row. -->
    <style name="Theme.Crawl.CustomKeyboard" parent="Theme.Crawl">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="Theme.Crawl" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Classic parent keeps window/inset behaviour; colorControl* feed
             the Material SeekBar/EditText drawables. -->
        <item name="android:buttonStyle">@style/Widget.Crawl.Button</item>
        <item name="android:seekBarStyle">@style/Widget.Crawl.SeekBar</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Crawl.Dialog</item>
        <item name="android:colorAccent">@color/crawl_accent</item>
        <item name="android:colorControlNormal">@color/crawl_text_dim</item>
        <item name="android:colorControlActivated">@color/crawl_accent</item>
        <item name="android:colorControlHighlight">@color/crawl_ripple</item>
        <!--<item name="colorPrimary">@color/primary</item>-->
        <!--<item name="colorPrimaryDark">@color/primary_dark</item>-->
        <!--<item name="colorAccent">@color/accent</item>-->
        <!--<item name="android:windowBackground">@drawable/system_background</item>-->

        <!--<item name="actionModeBackground">@color/terrastride_accent</item>-->
        <!--<item name="actionBarPopupTheme">@style/ThemeOverlay.AppCompat.Light</item>-->
        <!--<item name="android:actionModeCloseDrawable">@drawable/ic_actionmode_cancel</item>-->
        <!--<item name="windowActionModeOverlay">true</item>-->

        <!--<item name="android:buttonStyle">@style/Theme.Hunter.Button</item>-->
        <!--<item name="android:imageButtonStyle">@style/Theme.Hunter.ImageButton</item>-->
        <!--<item name="android:colorEdgeEffect" tools:targetApi="lollipop">@color/accent_mono</item>-->

        <!--<item name="colorButtonNormal">@color/primary</item>-->
        <!--<item name="colorControlActivated">@color/accent</item>-->
        <!--<item name="colorControlHighlight">@color/accent</item>-->

        <!--<item name="android:toolbarStyle" tools:targetApi="lollipop">@style/ToolbarStyle</item>-->
        <!--<item name="toolbarStyle">@style/ToolbarStyle</item>-->
    </style>
    <!-- ===== Crawl UI skin. Colors are tokens in colors.xml. ===== -->

    <!-- AlertDialogs, ListPreference pickers and the 2-finger context menu
         (Android shows context menus as an AlertDialog). -->
    <style name="ThemeOverlay.Crawl.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_crawl</item>
        <item name="android:colorBackground">@color/crawl_surface</item>
        <item name="android:colorAccent">@color/crawl_accent</item>
        <item name="android:colorControlNormal">@color/crawl_text_dim</item>
        <item name="android:colorControlActivated">@color/crawl_accent</item>
        <item name="android:colorControlHighlight">@color/crawl_ripple</item>
        <item name="android:textColorPrimary">@color/crawl_text</item>
        <item name="android:textColorSecondary">@color/crawl_text_dim</item>
        <item name="android:buttonStyle">@style/Widget.Crawl.Button</item>
        <item name="android:seekBarStyle">@style/Widget.Crawl.SeekBar</item>
    </style>

    <!-- Toggle buttons are plain Widget.Crawl.Button driven by
         setActivated(); the activated state is in btn_crawl.xml. -->
    <style name="Widget.Crawl.Button" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/btn_crawl</item>
        <item name="android:textColor">@color/crawl_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="Widget.Crawl.Button.Primary">
        <item name="android:background">@drawable/btn_crawl_primary</item>
        <item name="android:textColor">@color/crawl_text_on_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Crawl.SeekBar" parent="@android:style/Widget.Material.SeekBar" />

    <!-- Grid overlay editor bar (reposition_buttons.xml). Four toggles share
         one row, so padding and text are trimmed to keep them on one line. -->
    <style name="RepositionToggleButton" parent="Widget.Crawl.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <!-- Opens a picker: caret at the right edge. -->
    <style name="RepositionMenuButton" parent="RepositionToggleButton">
        <item name="android:drawableEnd">@drawable/ic_caret_down</item>
        <item name="android:paddingLeft">4dp</item>
    </style>
    <style name="RepositionBarButton" parent="Widget.Crawl.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
    </style>
    <style name="RepositionBarButton.Primary">
        <item name="android:background">@drawable/btn_crawl_primary</item>
        <item name="android:textColor">@color/crawl_text_on_accent</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="RepositionOpacityLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minEms">5</item>
        <item name="android:textColor">@color/crawl_text</item>
    </style>
    <style name="RepositionOpacitySeek" parent="Widget.Crawl.SeekBar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:max">100</item>
    </style>
    <style name="RepositionColorSwatch">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>