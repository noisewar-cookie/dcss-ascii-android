<?xml version="1.0" encoding="utf-8"?>
<!-- UI palette for the app's own chrome (editor bars, dialogs, pickers).
     Widget styles in styles.xml reference these; change a token here to
     reskin everywhere. Terminal/game colors live in font_config. -->
<resources>
    <color name="crawl_bg">#FF000000</color>
    <color name="crawl_surface">#FF1A1A1A</color>
    <color name="crawl_raised">#FF2A2A2A</color>
    <!-- Fill of an activated toggle: darker than surface so it reads as
         pressed in. -->
    <color name="crawl_inset">#FF0E0E0E</color>
    <color name="crawl_border">#FF3A3A3A</color>
    <!-- Dialog frame; matches icon_config modal_border_color. -->
    <color name="crawl_frame">#FF8F5630</color>
    <color name="crawl_accent">#FFE0A040</color>
    <color name="crawl_ripple">#40E0A040</color>
    <color name="crawl_text">#FFE6E6E6</color>
    <color name="crawl_text_dim">#FF8A8A8A</color>
    <color name="crawl_text_disabled">#FF555555</color>
    <color name="crawl_text_on_accent">#FF1A1000</color>
</resources>
