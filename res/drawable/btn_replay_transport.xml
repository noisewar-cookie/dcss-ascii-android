<?xml version="1.0" encoding="utf-8"?>
<!-- Replay transport buttons: btn_crawl with a heavier, brighter border. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/crawl_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/crawl_surface" />
                    <stroke android:width="1dp" android:color="@color/crawl_border" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/crawl_inset" />
                    <stroke android:width="2dp" android:color="@color/crawl_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/crawl_raised" />
                    <stroke android:width="1.5dp" android:color="#FF6A6A6A" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
