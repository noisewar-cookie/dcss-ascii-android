<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="12"
    android:viewportHeight="12">
    <!-- Two round-capped diagonals forming an X. The viewport is cropped to the
         stroke bounds so the glyph fills the box edge-to-edge, letting an
         equal LayoutParams margin read as an equal pixel gap from each border. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M1 1 L11 11 M11 1 L1 11" />
</vector>
